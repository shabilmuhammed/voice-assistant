<Window x:Class="Hark.App.Voice.VoiceOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:Hark.App.Controls"
        Title="Hark voice" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="Height" Width="560" Focusable="False">
    <Window.Resources>
        <!-- The overlay keeps one dark look in both Windows themes, so it reads the same over any app. -->
        <SolidColorBrush x:Key="OverlaySurface" Color="#F21B2128" />
        <SolidColorBrush x:Key="OverlayStroke" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="OverlayText" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="OverlayMuted" Color="#B3FFFFFF" />
        <SolidColorBrush x:Key="OverlayGlow" Color="#5CC4E8" />
        <Style x:Key="OverlayButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource OverlayMuted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="24" CornerRadius="22" Background="{StaticResource OverlaySurface}"
            BorderBrush="{StaticResource OverlayStroke}" BorderThickness="1" Padding="18,16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.45" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- The orb: a soft halo that swells with your voice, around a steady core. -->
            <Grid Grid.Column="0" Width="56" Height="56" VerticalAlignment="Top" Margin="0,0,16,0">
                <Ellipse x:Name="Halo" Fill="{StaticResource OverlayGlow}" Opacity="0.28" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><ScaleTransform x:Name="HaloScale" ScaleX="0.7" ScaleY="0.7" /></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Core" Width="34" Height="34" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Fill>
                        <RadialGradientBrush GradientOrigin="0.35,0.3">
                            <GradientStop Color="#C9F1FF" Offset="0" />
                            <GradientStop Color="#5CC4E8" Offset="0.45" />
                            <GradientStop Color="#0A6A8F" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform><ScaleTransform x:Name="CoreScale" /></Ellipse.RenderTransform>
                </Ellipse>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Caption}" Foreground="{StaticResource OverlayText}" FontSize="16" FontWeight="SemiBold"
                           TextWrapping="Wrap" Visibility="{Binding Caption, Converter={StaticResource TextToVisibility}}" />
                <TextBlock Text="{Binding Heard}" Foreground="{StaticResource OverlayMuted}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0"
                           Visibility="{Binding Heard, Converter={StaticResource TextToVisibility}}" />
                <TextBlock Text="Say what you need. Esc cancels." Foreground="{StaticResource OverlayMuted}" FontSize="13" Margin="0,2,0,0"
                           Visibility="{Binding IsListening, Converter={StaticResource BoolToVisibility}}" />
                <ScrollViewer MaxHeight="300" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" Focusable="False"
                              Visibility="{Binding ShowAnswer, Converter={StaticResource BoolToVisibility}}">
                    <ctl:MarkdownView Markdown="{Binding Answer, Mode=OneWay}" Foreground="{StaticResource OverlayText}" FontSize="14" />
                </ScrollViewer>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,-4,-6,0">
                <Button Style="{StaticResource OverlayButton}" Command="{Binding OpenHarkCommand}" Padding="8,6" ToolTip="Open in Hark"
                        AutomationProperties.Name="Open in Hark">
                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="13" Text="&#xE8A7;" />
                </Button>
                <Button Style="{StaticResource OverlayButton}" Command="{Binding DismissCommand}" Padding="8,6" ToolTip="Close"
                        AutomationProperties.Name="Close">
                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="12" Text="&#xE711;" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
