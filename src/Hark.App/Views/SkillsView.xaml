<UserControl x:Class="Hark.App.Views.SkillsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Hark.Core;assembly=Hark.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid Margin="24,4,24,40" MaxWidth="720">

            <!-- ============ list ============ -->
            <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource H.Primary}" Command="{Binding NewCommand}" AutomationProperties.Name="New skill">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE710;" Margin="0,0,8,0" />
                            <TextBlock Text="New skill" />
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource H.Ghost}" Content="Open folder" Command="{Binding OpenFolderCommand}" Margin="0,0,8,0" />
                    <StackPanel VerticalAlignment="Center" Margin="4,0,16,0">
                        <TextBlock Style="{StaticResource Secondary}" Text="Type / in a chat to use a skill. New skills are saved in your personal Copilot skills folder:" />
                        <TextBlock Text="{Binding Folder}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource H.Ink2}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>

                <Border Background="{DynamicResource H.OkSoft}" CornerRadius="10" Padding="13,9" Margin="0,0,0,10"
                        Visibility="{Binding Note, Converter={StaticResource TextToVisibility}}">
                    <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="13.5" Foreground="{DynamicResource H.Ok}" />
                </Border>

                <Border Style="{StaticResource Card}" Padding="24,28" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="No skills yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource Secondary}" TextAlignment="Center" Margin="0,6,0,0" MaxWidth="420"
                                   Text="A skill is a set of instructions Copilot follows for one kind of job, like writing release notes or raising test coverage. Create one, then run it from any chat with /its-name." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type core:SkillInfo}">
                                <Border x:Name="Row" Style="{StaticResource Row}" Background="Transparent">
                                    <DockPanel>
                                        <Button x:Name="EditButton" DockPanel.Dock="Right" Style="{StaticResource H.Button}" Content="Edit" Margin="12,0,0,0"
                                                VerticalAlignment="Center" AutomationProperties.Name="Edit this skill"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Border x:Name="SourceBadge" DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{DynamicResource H.Sunken}"
                                                Margin="12,0,0,0" Visibility="Collapsed">
                                            <TextBlock Text="{Binding Source}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource H.Ink2}" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Command}" FontFamily="{StaticResource MonoFont}" FontSize="13.5" FontWeight="Medium"
                                                       Foreground="{DynamicResource H.Ink}" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Editable}" Value="False">
                                        <Setter TargetName="EditButton" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="SourceBadge" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <!-- ============ editor ============ -->
            <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding EditorTitle}" FontSize="18" FontWeight="SemiBold" Margin="4,0,0,12" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Border Style="{StaticResource Row}">
                            <StackPanel>
                                <TextBlock Text="Name" Style="{StaticResource RowTitle}" />
                                <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,8"
                                           Text="What you type after / to run it. Lower case letters, numbers and hyphens. It cannot be changed later." />
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="/" FontFamily="{StaticResource MonoFont}" FontSize="15" VerticalAlignment="Center"
                                               Foreground="{DynamicResource H.Ink3}" Margin="2,0,6,0" />
                                    <TextBox x:Name="NameBox" Style="{StaticResource H.Field}" FontFamily="{StaticResource MonoFont}"
                                             Text="{Binding EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{Binding IsNew, Converter={StaticResource InvertBool}}" AutomationProperties.Name="Skill name" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <StackPanel>
                                <TextBlock Text="Description" Style="{StaticResource RowTitle}" />
                                <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,8"
                                           Text="What the skill does and when to use it. Copilot reads this to decide when the skill fits, so be specific." />
                                <TextBox Style="{StaticResource H.FieldMulti}" MinHeight="60" MaxHeight="120"
                                         Text="{Binding EditDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Description" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <DockPanel>
                                <TextBox DockPanel.Dock="Right" Style="{StaticResource H.Field}" Width="220" VerticalAlignment="Center"
                                         Text="{Binding EditArgumentHint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Input hint" />
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Input hint (optional)" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="What to type after the name, for example &lt;version&gt; or &lt;repo name&gt;." Style="{StaticResource Secondary}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource LastRow}">
                            <StackPanel>
                                <TextBlock Text="Instructions" Style="{StaticResource RowTitle}" />
                                <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,8"
                                           Text="The steps Copilot follows when the skill runs. Markdown works: headings, numbered steps, code blocks." />
                                <TextBox Style="{StaticResource H.FieldMulti}" MinHeight="260" MaxHeight="460" AcceptsTab="True"
                                         FontFamily="{StaticResource MonoFont}" FontSize="13"
                                         Text="{Binding EditInstructions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Instructions" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource H.ErrSoft}" CornerRadius="10" Padding="13,9" Margin="0,12,0,0"
                        Visibility="{Binding Error, Converter={StaticResource TextToVisibility}}">
                    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" FontSize="13.5" Foreground="{DynamicResource H.Err}" />
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Style="{StaticResource H.Button}" Content="Cancel" Command="{Binding CancelCommand}" />
                    <Button Style="{StaticResource H.Primary}" Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
