<UserControl x:Class="Hark.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,14" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBox DockPanel.Dock="Right" Width="260" VerticalAlignment="Center"
                         Text="{Binding Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                         AutomationProperties.Name="Search chats" />
                <TextBlock DockPanel.Dock="Right" Text="Search" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="12,0,8,0" />
                <TextBlock Text="History" Style="{StaticResource PageTitle}" />
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="1" Text="No chats yet. Chats you have are saved on this PC and listed here."
                   Style="{StaticResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Items}" Margin="24,12" MaxWidth="820" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="14,10"
                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Updated, StringFormat='{}{0:d MMM, HH:mm}'}"
                                               Style="{StaticResource Secondary}" Margin="12,0,0,0" VerticalAlignment="Top" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Preview}" Style="{StaticResource Secondary}" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                   Visibility="{Binding Preview, Converter={StaticResource TextToVisibility}}" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                            <Button Grid.Column="1" Margin="6,0,0,0" Padding="10,0" VerticalAlignment="Stretch" ToolTip="Delete this chat"
                                    AutomationProperties.Name="Delete this chat"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE74D;" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
