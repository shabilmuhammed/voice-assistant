<UserControl x:Class="Hark.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Hark.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="24,4,24,40" MaxWidth="720">
            <Grid Margin="0,0,0,10">
                <TextBox x:Name="SearchBox" Style="{StaticResource H.Field}" Padding="34,8,10,8" Background="{DynamicResource H.Surface}"
                         Text="{Binding Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=250}" AutomationProperties.Name="Search chats" />
                <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE721;" Margin="12,0,0,0" HorizontalAlignment="Left"
                           Foreground="{DynamicResource H.Ink3}" IsHitTestVisible="False" />
            </Grid>

            <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Secondary}" HorizontalAlignment="Center" Margin="0,60,0,0"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

            <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                <ItemsControl.Resources>
                    <DataTemplate DataType="{x:Type vm:ChatGroupHeader}">
                        <TextBlock Text="{Binding Text}" Style="{StaticResource GroupLabel}" Margin="4,16,0,8" />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:ChatRowVm}">
                        <Border x:Name="RowFrame" Style="{StaticResource Card}" CornerRadius="12" Margin="0,0,0,6">
                            <DockPanel>
                                <Button x:Name="Delete" DockPanel.Dock="Right" Style="{StaticResource H.IconButton}" Margin="0,0,8,0" Opacity="0"
                                        ToolTip="Delete this chat" AutomationProperties.Name="Delete this chat"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE74D;" />
                                </Button>
                                <Button Style="{StaticResource H.RowButton}" Padding="16,12"
                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding When}" FontSize="12.5" Foreground="{DynamicResource H.Ink3}"
                                                   Margin="12,1,0,0" VerticalAlignment="Top" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="Medium" Foreground="{DynamicResource H.Ink}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Preview}" FontSize="13" Foreground="{DynamicResource H.Ink2}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                       Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                            </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="RowFrame" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Delete" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger SourceName="RowFrame" Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Delete" Property="Opacity" Value="1" />
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.Resources>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
