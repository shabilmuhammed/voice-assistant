<Window x:Class="Hark.App.Views.QuickPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:Hark.App.Controls"
        Title="MarTechChat quick prompt" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="Height" Width="560"
        FontFamily="{StaticResource UiFont}" TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <!-- The panel keeps one dark look in both Windows themes, so it reads the same over any app. -->
        <SolidColorBrush x:Key="OverlaySurface" Color="#F21B2128" />
        <SolidColorBrush x:Key="OverlayStroke" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="OverlayText" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="OverlayMuted" Color="#B3FFFFFF" />
        <SolidColorBrush x:Key="OverlayGlow" Color="#5CC4E8" />
        <Style x:Key="OverlayButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource OverlayMuted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A bare text box: no border or fill of its own, so it sits straight on the panel. -->
        <Style x:Key="PromptBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource OverlayText}" />
            <Setter Property="CaretBrush" Value="{StaticResource OverlayGlow}" />
            <Setter Property="SelectionBrush" Value="{StaticResource OverlayGlow}" />
            <Setter Property="SelectionOpacity" Value="0.35" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Padding="0" Margin="-2,0,0,0" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Surface" Margin="24" CornerRadius="26" Background="{StaticResource OverlaySurface}"
            BorderBrush="{StaticResource OverlayStroke}" BorderThickness="1" Padding="18,16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.45" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- The orb: a soft halo that swells as you type, around a steady core. -->
            <Grid Grid.Column="0" Width="56" Height="56" VerticalAlignment="Top" Margin="0,0,16,0">
                <Ellipse x:Name="Halo" Fill="{StaticResource OverlayGlow}" Opacity="0.28" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><ScaleTransform x:Name="HaloScale" ScaleX="0.7" ScaleY="0.7" /></Ellipse.RenderTransform>
                </Ellipse>
                <ctl:Orb x:Name="Core" Width="36" Height="36" RenderTransformOrigin="0.5,0.5" Lively="{Binding IsTyping}">
                    <ctl:Orb.RenderTransform><ScaleTransform x:Name="CoreScale" /></ctl:Orb.RenderTransform>
                </ctl:Orb>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <!-- typing -->
                <StackPanel Visibility="{Binding IsTyping, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <TextBlock Text="Ask MarTechChat…" Foreground="{StaticResource OverlayMuted}" FontSize="16" IsHitTestVisible="False"
                                   Visibility="{Binding Text, ElementName=Input, Converter={StaticResource TextToVisibility}, ConverterParameter=invert}" />
                        <TextBox x:Name="Input" Style="{StaticResource PromptBox}" MaxHeight="140"
                                 Text="{Binding Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="Input_PreviewKeyDown" TextChanged="Input_TextChanged"
                                 AutomationProperties.Name="Ask MarTechChat" />
                    </Grid>
                    <TextBlock Text="Enter sends. Shift + Enter adds a line. Esc closes." Foreground="{StaticResource OverlayMuted}" FontSize="12.5" Margin="0,6,0,0" />
                </StackPanel>

                <TextBlock Text="{Binding Caption}" Foreground="{StaticResource OverlayText}" FontSize="16" FontWeight="SemiBold"
                           TextWrapping="Wrap" Visibility="{Binding Caption, Converter={StaticResource TextToVisibility}}" />
                <TextBlock Text="{Binding Asked}" Foreground="{StaticResource OverlayMuted}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0"
                           Visibility="{Binding ShowAsked, Converter={StaticResource BoolToVisibility}}" />
                <ScrollViewer MaxHeight="300" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" Focusable="False"
                              Visibility="{Binding ShowAnswer, Converter={StaticResource BoolToVisibility}}">
                    <ctl:MarkdownView Markdown="{Binding Answer, Mode=OneWay}" Foreground="{StaticResource OverlayText}" FontSize="14" />
                </ScrollViewer>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,-4,-6,0">
                <Button Style="{StaticResource OverlayButton}" Command="{Binding OpenAppCommand}" Padding="8,6" ToolTip="Open in MarTechChat"
                        AutomationProperties.Name="Open in MarTechChat">
                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="13" Text="&#xE8A7;" />
                </Button>
                <Button Style="{StaticResource OverlayButton}" Command="{Binding DismissCommand}" Padding="8,6" ToolTip="Close (Esc)"
                        AutomationProperties.Name="Close">
                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="12" Text="&#xE711;" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
