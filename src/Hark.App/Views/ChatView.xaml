<UserControl x:Class="Hark.App.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Hark.App.ViewModels"
             xmlns:ctl="clr-namespace:Hark.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title, model, new chat -->
        <Border Grid.Row="0" Padding="24,14" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding NewChatCommand}" Margin="12,0,0,0" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE710;" Margin="0,0,8,0" />
                        <TextBlock Text="New chat" />
                    </StackPanel>
                </Button>
                <ComboBox DockPanel.Dock="Right" MinWidth="190" VerticalAlignment="Center"
                          ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                          DisplayMemberPath="Name" AutomationProperties.Name="Model" />
                <TextBlock DockPanel.Dock="Right" Text="Model" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="12,0,8,0" />
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
            </DockPanel>
        </Border>

        <!-- Messages -->
        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Margin="24"
                            x:Name="EmptyState">
                    <TextBlock Text="Ask about your repos, work items or data" FontSize="18" FontWeight="SemiBold"
                               TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Secondary}" TextAlignment="Center" Margin="0,8,0,0"
                               Text="Hark sends your message to GitHub Copilot and lets it use the tools from your mcp.json. Press Enter to send, Shift+Enter for a new line." />
                </StackPanel>

                <ItemsControl x:Name="MessageList" ItemsSource="{Binding Messages}" Margin="24,18" MaxWidth="820" Focusable="False">
                    <ItemsControl.Resources>
                        <DataTemplate DataType="{x:Type vm:UserMessageVm}">
                            <Border HorizontalAlignment="Right" MaxWidth="600" Margin="60,8,0,8" Padding="14,9" CornerRadius="12,12,3,12"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                                <StackPanel>
                                    <Button Command="{Binding OpenImageCommand}" Padding="0" Margin="0,2,0,8" BorderThickness="0"
                                            HorizontalAlignment="Left" Cursor="Hand" ToolTip="Open the capture that was sent"
                                            AutomationProperties.Name="Open the screen capture that was sent"
                                            Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}">
                                        <Image Source="{Binding ImagePath}" MaxHeight="150" MaxWidth="320" Stretch="Uniform" />
                                    </Button>
                                    <TextBox Style="{StaticResource SelectableText}" Text="{Binding Text, Mode=OneWay}"
                                             Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type vm:AssistantMessageVm}">
                            <ctl:MarkdownView Markdown="{Binding Text, Mode=OneWay}" Margin="0,8,40,8" />
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type vm:ToolCallVm}">
                            <Border Margin="0,4" Padding="10,6" CornerRadius="6" HorizontalAlignment="Left"
                                    BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE90F;" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" />
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource Secondary}" Margin="10,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Error}" Margin="21,4,0,0" FontSize="12.5" TextWrapping="Wrap" MaxWidth="640"
                                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                               Visibility="{Binding Error, Converter={StaticResource TextToVisibility}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type vm:ApprovalVm}">
                            <Border Style="{StaticResource Card}" Margin="0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <ScrollViewer MaxHeight="160" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto"
                                                  Visibility="{Binding Detail, Converter={StaticResource TextToVisibility}}">
                                        <TextBox Style="{StaticResource SelectableText}" Text="{Binding Detail, Mode=OneWay}"
                                                 FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </ScrollViewer>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                                Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}">
                                        <Button Content="Allow once" Command="{Binding AllowOnceCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="14,6" />
                                        <Button Content="{Binding AlwaysLabel}" Command="{Binding AlwaysAllowCommand}" Margin="8,0,0,0" Padding="14,6" />
                                        <Button Content="Deny" Command="{Binding DenyCommand}" Margin="8,0,0,0" Padding="14,6" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Outcome}" Style="{StaticResource Secondary}" Margin="0,8,0,0"
                                               Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type vm:ErrorVm}">
                            <TextBox Style="{StaticResource SelectableText}" Text="{Binding Text, Mode=OneWay}" Margin="0,8"
                                     Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type vm:NoteVm}">
                            <TextBlock Text="{Binding Text}" Style="{StaticResource Secondary}" Margin="0,8" />
                        </DataTemplate>
                    </ItemsControl.Resources>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

        <!-- Status line -->
        <TextBlock Grid.Row="2" Text="{Binding Status}" Style="{StaticResource Secondary}" Margin="24,0,24,6"
                   Visibility="{Binding Status, Converter={StaticResource TextToVisibility}}" />

        <!-- Composer -->
        <Border Grid.Row="3" Padding="24,12,24,18" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <DockPanel MaxWidth="820">
                <Button DockPanel.Dock="Right" Margin="10,0,0,0" Padding="16,8" VerticalAlignment="Bottom"
                        Command="{Binding StopCommand}" Content="Stop"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <Button DockPanel.Dock="Right" Margin="10,0,0,0" Padding="16,8" VerticalAlignment="Bottom"
                        Command="{Binding SendCommand}" Style="{DynamicResource AccentButtonStyle}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE724;" Margin="0,0,8,0" />
                        <TextBlock Text="Send" />
                    </StackPanel>
                </Button>
                <ToggleButton DockPanel.Dock="Left" Margin="0,0,10,0" Padding="10,8" VerticalAlignment="Bottom"
                              IsChecked="{Binding IncludeScreen, Mode=TwoWay}"
                              ToolTip="Send a capture of your whole screen with the next message"
                              AutomationProperties.Name="Include my screen with the next message">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" />
                </ToggleButton>
                <TextBox x:Name="InputBox" Text="{Binding Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="38" MaxHeight="150" FontSize="14"
                         VerticalScrollBarVisibility="Auto" PreviewKeyDown="InputBox_PreviewKeyDown"
                         AutomationProperties.Name="Message" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
