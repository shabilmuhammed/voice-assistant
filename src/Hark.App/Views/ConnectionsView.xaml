<UserControl x:Class="Hark.App.Views.ConnectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="24,4,24,40" MaxWidth="720">

            <TextBlock Text="GitHub Copilot" Style="{StaticResource GroupLabel}" />
            <Border Style="{StaticResource Card}">
                <Border Style="{StaticResource LastRow}">
                    <StackPanel>
                        <DockPanel>
                            <Border x:Name="PatBadge" DockPanel.Dock="Right" Style="{StaticResource Badge}" Margin="12,0,0,0"
                                    Visibility="{Binding DataContext.IsConnected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Connected" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource H.Ok}" />
                            </Border>
                            <TextBlock Text="Personal access token" Style="{StaticResource RowTitle}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,12"
                                   Text="A fine-grained token with the Copilot Requests permission. It is the only GitHub sign-in MarTechChat uses, and it is saved as plain text in settings.json on this PC." />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Save and test" Margin="10,0,0,0" Style="{StaticResource H.Primary}" Command="{Binding SaveAndTestCommand}" />
                            <PasswordBox x:Name="PatBox" Style="{StaticResource H.PasswordField}" PasswordChanged="PatBox_PasswordChanged"
                                         AutomationProperties.Name="GitHub personal access token" />
                        </DockPanel>
                        <TextBlock Text="{Binding PatStatus}" Style="{StaticResource Secondary}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </Border>

            <DockPanel Margin="0,26,0,0">
                <Button DockPanel.Dock="Right" Content="Reload" Command="{Binding ReloadCommand}" Style="{StaticResource H.Ghost}" Margin="0,0,0,6" />
                <Button DockPanel.Dock="Right" Content="Open mcp.json" Command="{Binding OpenMcpFileCommand}" Style="{StaticResource H.Ghost}" Margin="0,0,0,6" />
                <TextBlock Text="Tool servers" Style="{StaticResource GroupLabel}" VerticalAlignment="Center" />
            </DockPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Border Style="{StaticResource Row}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Secondary}"
                                       Text="Read from the same file VS Code uses, so a change in either place applies to both. Tokens for these servers live in that file." />
                            <TextBox Style="{StaticResource SelectableText}" Text="{Binding McpPath, Mode=OneWay}"
                                     FontFamily="{StaticResource MonoFont}" FontSize="12.5" Margin="0,6,0,0" Foreground="{DynamicResource H.Ink2}" />
                            <TextBlock Text="{Binding McpStatus}" Style="{StaticResource Secondary}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Servers}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Row}">
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource H.Switch}" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                  ToolTip="Use this server in chats" AutomationProperties.Name="{Binding Name}" />
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource LastRow}" Visibility="{Binding Warnings, Converter={StaticResource TextToVisibility}}">
                        <TextBlock Text="{Binding Warnings}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource H.Warn}" />
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Text="Purview sign-in" Style="{StaticResource GroupLabel}" Margin="4,26,0,8" />
            <Border Style="{StaticResource Card}">
                <Border Style="{StaticResource LastRow}">
                    <TextBlock Style="{StaticResource Secondary}"
                               Text="Your martechchat server signs in to Microsoft by itself: the first time a Purview tool runs in a chat, your browser opens. MarTechChat keeps the server running in the background, so the sign-in is reused until it expires or MarTechChat is closed." />
                </Border>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
