<UserControl x:Class="Hark.App.Views.ConnectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,14" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="Connections" Style="{StaticResource PageTitle}" />
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,18" MaxWidth="820">

                <!-- GitHub Copilot -->
                <TextBlock Text="GitHub Copilot" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Fine-grained personal access token" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,10"
                                   Text="Needs the Copilot Requests permission. It is the only GitHub sign-in Hark uses, and it is saved as plain text in settings.json on this PC." />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Save and test" Margin="10,0,0,0" Padding="14,6"
                                    Style="{DynamicResource AccentButtonStyle}" Command="{Binding SaveAndTestCommand}" />
                            <PasswordBox x:Name="PatBox" PasswordChanged="PatBox_PasswordChanged"
                                         AutomationProperties.Name="GitHub personal access token" />
                        </DockPanel>
                        <TextBlock Text="{Binding PatStatus}" Style="{StaticResource Secondary}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- MCP servers -->
                <DockPanel Margin="0,26,0,0">
                    <Button DockPanel.Dock="Right" Content="Reload" Command="{Binding ReloadCommand}" Padding="12,5" Margin="8,0,0,8" />
                    <Button DockPanel.Dock="Right" Content="Open mcp.json" Command="{Binding OpenMcpFileCommand}" Padding="12,5" Margin="8,0,0,8" />
                    <TextBlock Text="MCP servers" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                </DockPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Secondary}"
                                   Text="Read from the same file VS Code uses, so a change in either place applies to both. Tokens for these servers live in that file." />
                        <TextBox Style="{StaticResource SelectableText}" Text="{Binding McpPath, Mode=OneWay}"
                                 FontFamily="{StaticResource MonoFont}" FontSize="12.5" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding McpStatus}" Style="{StaticResource Secondary}" Margin="0,6,0,0" />

                        <ItemsControl ItemsSource="{Binding Servers}" Margin="0,10,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Enabled, Mode=TwoWay}" Content="Use in chats"
                                                      VerticalAlignment="Center" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding Warnings}" TextWrapping="Wrap" FontSize="12.5" Margin="0,8,0,0"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   Visibility="{Binding Warnings, Converter={StaticResource TextToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- Purview -->
                <TextBlock Text="Purview sign-in" Style="{StaticResource SectionTitle}" Margin="0,26,0,8" />
                <Border Style="{StaticResource Card}">
                    <TextBlock Style="{StaticResource Secondary}"
                               Text="Your martechchat server signs in to Microsoft by itself: the first time a Purview tool runs in a chat, your browser opens. Hark keeps the server running in the background, so the sign-in is reused until it expires or Hark is closed." />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
