<UserControl x:Class="Hark.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="24,4,24,40" MaxWidth="720">

            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" Style="{StaticResource Secondary}" Margin="0,0,4,8" />
                <TextBlock Text="Chat" Style="{StaticResource GroupLabel}" />
            </DockPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <ListBox DockPanel.Dock="Right" Style="{StaticResource H.Segment}" ItemsSource="{Binding Approvals}" DisplayMemberPath="Label"
                                     SelectedItem="{Binding Approval, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="Tool approvals" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Tool approvals" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{Binding ApprovalExplanation}" Style="{StaticResource Secondary}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource LastRow}">
                        <DockPanel>
                            <ComboBox DockPanel.Dock="Right" Width="220" ItemsSource="{Binding Models}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding DefaultModel, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="Default model" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Default model" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Used for new chats. You can still switch per chat." Style="{StaticResource Secondary}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Text="Voice" Style="{StaticResource GroupLabel}" Margin="4,26,0,8" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource H.Switch}" IsChecked="{Binding VoiceEnabled, Mode=TwoWay}"
                                      AutomationProperties.Name="Listen for the wake phrase" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Listen for the wake phrase" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="The microphone is processed on this PC only. Nothing is sent until you have spoken a request, and then only the text."
                                           Style="{StaticResource Secondary}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource H.Field}" Width="220" VerticalAlignment="Center"
                                     Text="{Binding WakePhrase, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Wake phrase" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Wake phrase" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Two plain English words work best. No training is needed." Style="{StaticResource Secondary}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <Slider DockPanel.Dock="Right" Width="220" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center" Value="{Binding WakeSensitivity, Mode=TwoWay}" AutomationProperties.Name="Wake sensitivity" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Sensitivity" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Left is stricter: fewer accidental wake-ups, but it may miss you. Right wakes more easily." Style="{StaticResource Secondary}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <ComboBox DockPanel.Dock="Right" Width="220" ItemsSource="{Binding Microphones}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding Microphone, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="Microphone" />
                            <TextBlock Text="Microphone" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource H.Switch}" IsChecked="{Binding WakeOnWords, Mode=TwoWay}"
                                      AutomationProperties.Name="Also wake on recognised words" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Also wake on recognised words" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="MarTechChat transcribes what it hears on this PC and wakes when the words match. It reacts after a short pause and copes better with accents."
                                           Style="{StaticResource Secondary}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource H.Field}" Width="220" VerticalAlignment="Center"
                                     Text="{Binding AlsoWakeOn, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Also wake on" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Also wake on" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="If the check below shows your wake phrase heard as something else, add that here. Separate phrases with commas."
                                           Style="{StaticResource Secondary}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <ProgressBar DockPanel.Dock="Right" Width="220" Height="6" Minimum="0" Maximum="1" VerticalAlignment="Center"
                                         Value="{Binding Voice.Level, Mode=OneWay}" Foreground="{DynamicResource H.Signal}" Background="{DynamicResource H.Sunken}"
                                         BorderThickness="0" AutomationProperties.Name="Microphone level" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="What MarTechChat hears" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{Binding Voice.LastHeard}" Style="{StaticResource Secondary}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource LastRow}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Secondary}"
                                       Text="Ctrl + Alt + Space starts listening without the wake phrase. Esc cancels while MarTechChat is listening." />
                            <TextBlock Text="{Binding VoiceNote}" TextWrapping="Wrap" FontSize="13" Margin="0,6,0,0" Foreground="{DynamicResource H.Warn}"
                                       Visibility="{Binding VoiceNote, Converter={StaticResource TextToVisibility}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Text="Folders" Style="{StaticResource GroupLabel}" Margin="4,26,0,8" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Border Style="{StaticResource Row}">
                        <StackPanel>
                            <TextBlock Text="Repositories" Style="{StaticResource RowTitle}" />
                            <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,8"
                                       Text="The folder that holds your cloned repos. Copilot can pull, branch, edit, and commit and push when you ask it to." />
                            <TextBox Style="{StaticResource H.Field}" Text="{Binding ReposRoot, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Repositories folder" />
                            <TextBlock Text="{Binding ReposNote}" Style="{StaticResource Secondary}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <StackPanel>
                            <TextBlock Text="Generated files" Style="{StaticResource RowTitle}" />
                            <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,8">
                                <Run Text="Where files you ask Copilot to create are saved. Leave empty to use" />
                                <Run Text="{Binding OutputDefault, Mode=OneWay}" />
                            </TextBlock>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Open folder" Command="{Binding OpenOutputFolderCommand}" Style="{StaticResource H.Button}" Margin="10,0,0,0" />
                                <TextBox Style="{StaticResource H.Field}" Text="{Binding OutputFolder, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Generated files folder" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <StackPanel>
                            <TextBlock Text="Tool servers file" Style="{StaticResource RowTitle}" />
                            <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,8">
                                <Run Text="Leave empty to use the VS Code file:" />
                                <Run Text="{Binding McpDefaultPath, Mode=OneWay}" />
                            </TextBlock>
                            <TextBox Style="{StaticResource H.Field}" Text="{Binding McpConfigPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Tool servers file" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource LastRow}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Open folder" Command="{Binding OpenDataFolderCommand}" Style="{StaticResource H.Button}" Margin="10,0,0,0" />
                            <StackPanel>
                                <TextBlock Text="Chats, settings and log" Style="{StaticResource RowTitle}" />
                                <TextBox Style="{StaticResource SelectableText}" Text="{Binding DataFolder, Mode=OneWay}" FontFamily="{StaticResource MonoFont}"
                                         FontSize="12.5" Foreground="{DynamicResource H.Ink2}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Text="App" Style="{StaticResource GroupLabel}" Margin="4,26,0,8" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource H.Switch}" IsChecked="{Binding CloseToTray, Mode=TwoWay}"
                                      AutomationProperties.Name="Keep running in the tray when the window is closed" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Keep running in the tray when the window is closed" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Use Quit in the tray icon's menu to stop MarTechChat completely." Style="{StaticResource Secondary}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource LastRow}">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource H.Switch}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                      AutomationProperties.Name="Start with Windows" />
                            <TextBlock Text="Start with Windows" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
