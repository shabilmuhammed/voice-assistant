<UserControl x:Class="Hark.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,14" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" Style="{StaticResource Secondary}" VerticalAlignment="Center" />
                <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,18" MaxWidth="820">

                <TextBlock Text="Chat" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <ComboBox DockPanel.Dock="Right" MinWidth="220" ItemsSource="{Binding Models}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding DefaultModel, Mode=TwoWay}" AutomationProperties.Name="Default model" />
                            <StackPanel>
                                <TextBlock Text="Default model" FontWeight="SemiBold" />
                                <TextBlock Text="Used for new chats. You can still switch per chat." Style="{StaticResource Secondary}" />
                            </StackPanel>
                        </DockPanel>
                        <CheckBox IsChecked="{Binding AutoApproveReadOnlyTools, Mode=TwoWay}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Let tools read without asking" FontWeight="SemiBold" />
                                <TextBlock Text="Tools that only look things up run straight away. Anything that creates or changes something still asks first."
                                           Style="{StaticResource Secondary}" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <TextBlock Text="App" Style="{StaticResource SectionTitle}" Margin="0,26,0,8" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding CloseToTray, Mode=TwoWay}">
                            <StackPanel>
                                <TextBlock Text="Keep running in the tray when the window is closed" FontWeight="SemiBold" />
                                <TextBlock Text="Use Quit in the tray icon's menu to stop Hark completely." Style="{StaticResource Secondary}" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{Binding StartWithWindows, Mode=TwoWay}" Margin="0,14,0,0">
                            <TextBlock Text="Start with Windows" FontWeight="SemiBold" />
                        </CheckBox>
                    </StackPanel>
                </Border>

                <TextBlock Text="Files" Style="{StaticResource SectionTitle}" Margin="0,26,0,8" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Repositories folder" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,8"
                                   Text="The folder that holds your cloned repos, for example C:\Users\you\source\repos. Copilot can pull, branch, edit, and commit and push when you ask it to. Each command asks first unless you allow commands for that chat." />
                        <TextBox Text="{Binding ReposRoot, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 AutomationProperties.Name="Repositories folder" />
                        <TextBlock Text="{Binding ReposNote}" Style="{StaticResource Secondary}" Margin="0,6,0,18" />

                        <TextBlock Text="Generated files folder" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,8">
                            <Run Text="Where files you ask Copilot to create are saved. Leave empty to use" />
                            <Run Text="{Binding OutputDefault, Mode=OneWay}" />
                        </TextBlock>
                        <DockPanel Margin="0,0,0,18">
                            <Button DockPanel.Dock="Right" Content="Open folder" Command="{Binding OpenOutputFolderCommand}" Padding="12,5" Margin="10,0,0,0" />
                            <TextBox Text="{Binding OutputFolder, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     AutomationProperties.Name="Generated files folder" />
                        </DockPanel>

                        <TextBlock Text="MCP config file" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,8">
                            <Run Text="Leave empty to use the VS Code file:" />
                            <Run Text="{Binding McpDefaultPath, Mode=OneWay}" />
                        </TextBlock>
                        <TextBox Text="{Binding McpConfigPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 AutomationProperties.Name="MCP config file path" />

                        <DockPanel Margin="0,18,0,0">
                            <Button DockPanel.Dock="Right" Content="Open folder" Command="{Binding OpenDataFolderCommand}" Padding="12,5" Margin="10,0,0,0" />
                            <StackPanel>
                                <TextBlock Text="Chats, settings and log" FontWeight="SemiBold" />
                                <TextBox Style="{StaticResource SelectableText}" Text="{Binding DataFolder, Mode=OneWay}"
                                         FontFamily="{StaticResource MonoFont}" FontSize="12.5" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
