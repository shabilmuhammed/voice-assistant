<Window x:Class="Hark.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Hark.App.ViewModels"
        xmlns:v="clr-namespace:Hark.App.Views"
        Title="MarTechChat" Icon="/Assets/app.ico" Width="1120" Height="760" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource H.Canvas}" Foreground="{DynamicResource H.Ink}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="54" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ChatViewModel}"><v:ChatView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><v:HistoryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConnectionsViewModel}"><v:ConnectionsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>

        <!-- Sidebar: day heading -->
        <DataTemplate DataType="{x:Type vm:ChatGroupHeader}">
            <TextBlock Text="{Binding Text}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource H.Ink3}" Margin="10,12,10,4" />
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Root" Background="{DynamicResource H.Canvas}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="268" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ sidebar ============ -->
            <Border Grid.Column="0" Background="{DynamicResource H.Sunken}" BorderBrush="{DynamicResource H.Line}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- brand (also the place to drag the window) -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="54" Margin="16,0,0,0">
                        <Image Source="/Assets/app-128.png" Width="28" Height="28" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="MarTechChat" FontSize="15.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>

                    <Button DockPanel.Dock="Top" Style="{StaticResource H.Button}" Margin="12,2,12,10" Padding="12,9"
                            Command="{Binding Chat.NewChatCommand}" AutomationProperties.Name="New chat">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE710;" Margin="0,0,10,0" />
                            <TextBlock Text="New chat" />
                        </StackPanel>
                    </Button>

                    <!-- navigation, with a selection pill that slides between items -->
                    <Grid DockPanel.Dock="Top" Margin="8,4,8,0">
                        <Border x:Name="NavPill" Height="36" VerticalAlignment="Top" CornerRadius="9"
                                Background="{DynamicResource H.Surface}" BorderBrush="{DynamicResource H.Line}" BorderThickness="1">
                            <Border.RenderTransform><TranslateTransform x:Name="NavPillMove" /></Border.RenderTransform>
                        </Border>
                        <ListBox Style="{StaticResource H.Nav}" SelectedIndex="{Binding SelectedNavIndex, Mode=TwoWay}" AutomationProperties.Name="Sections">
                            <ListBoxItem AutomationProperties.Name="Chat">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8BD;" Margin="0,0,11,0" /><TextBlock Text="Chat" VerticalAlignment="Center" /></StackPanel>
                            </ListBoxItem>
                            <ListBoxItem AutomationProperties.Name="History">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" Margin="0,0,11,0" /><TextBlock Text="History" VerticalAlignment="Center" /></StackPanel>
                            </ListBoxItem>
                            <ListBoxItem AutomationProperties.Name="Connections">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE71B;" Margin="0,0,11,0" /><TextBlock Text="Connections" VerticalAlignment="Center" /></StackPanel>
                            </ListBoxItem>
                            <ListBoxItem AutomationProperties.Name="Settings">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Margin="0,0,11,0" /><TextBlock Text="Settings" VerticalAlignment="Center" /></StackPanel>
                            </ListBoxItem>
                        </ListBox>
                    </Grid>

                    <!-- status -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource H.Line}" BorderThickness="0,1,0,0" Padding="14,10,14,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse x:Name="CopilotDot" Width="7" Height="7" Fill="{DynamicResource H.Ok}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding ConnectionStatus}" FontSize="12.5" Foreground="{DynamicResource H.Ink2}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource H.Ok}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding ToolsStatus}" FontSize="12.5" Foreground="{DynamicResource H.Ink2}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="VoiceDot" Width="7" Height="7" Fill="{DynamicResource H.Signal}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Voice.StatusText}" FontSize="12.5" Foreground="{DynamicResource H.Ink2}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- recent chats -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Recents}" Margin="8,0,8,8" Focusable="False">
                            <ItemsControl.Resources>
                                <DataTemplate DataType="{x:Type vm:ChatRowVm}">
                                    <Button Style="{StaticResource H.RowButton}" ToolTip="{Binding Title}"
                                            Command="{Binding DataContext.History.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock x:Name="RecentTitle" Text="{Binding Title}" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="RecentTitle" Property="FontWeight" Value="Medium" />
                                            <Setter TargetName="RecentTitle" Property="Foreground" Value="{DynamicResource H.Ink}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.Resources>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ============ main ============ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="54" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="20,0,6,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource H.Caption}" Click="Minimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize">
                            <TextBlock FontFamily="{StaticResource IconFont}" FontSize="10" Text="&#xE921;" />
                        </Button>
                        <Button Style="{StaticResource H.Caption}" Click="Maximize_Click" ToolTip="Maximize" AutomationProperties.Name="Maximize">
                            <TextBlock x:Name="MaximizeGlyph" FontFamily="{StaticResource IconFont}" FontSize="10" Text="&#xE922;" />
                        </Button>
                        <Button Style="{StaticResource H.CaptionClose}" Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close">
                            <TextBlock FontFamily="{StaticResource IconFont}" FontSize="10" Text="&#xE8BB;" />
                        </Button>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource H.IconButton}" Margin="0,0,10,0" Command="{Binding SearchChatsCommand}"
                            ToolTip="Search chats" AutomationProperties.Name="Search chats" WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Style="{StaticResource Icon}" FontSize="15" Text="&#xE721;" />
                    </Button>
                    <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}" />
                </DockPanel>

                <ContentControl x:Name="PageHost" Grid.Row="1" Content="{Binding CurrentPage}" Focusable="False" />
            </Grid>
        </Grid>
    </Border>
</Window>
