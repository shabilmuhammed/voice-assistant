<Window x:Class="Hark.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Hark.App.ViewModels"
        xmlns:v="clr-namespace:Hark.App.Views"
        Title="Hark" Icon="/Assets/hark.ico" Width="1060" Height="720" MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ChatViewModel}"><v:ChatView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><v:HistoryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConnectionsViewModel}"><v:ConnectionsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="208" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left navigation -->
        <Border Grid.Column="0" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="8,12">
                <TextBlock DockPanel.Dock="Top" Text="Hark" FontSize="18" FontWeight="Bold" Margin="12,4,0,14" />

                <StackPanel DockPanel.Dock="Bottom" Margin="12,8,8,4">
                    <TextBlock Text="GitHub Copilot" FontWeight="SemiBold" FontSize="12.5" />
                    <TextBlock Text="{Binding ConnectionStatus}" Style="{StaticResource Secondary}" />
                </StackPanel>

                <ListBox SelectedIndex="{Binding SelectedNavIndex, Mode=TwoWay}" Background="Transparent" BorderThickness="0"
                         AutomationProperties.Name="Sections">
                    <ListBoxItem AutomationProperties.Name="Chat">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8BD;" Margin="0,0,12,0" />
                            <TextBlock Text="Chat" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="History">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" Margin="0,0,12,0" />
                            <TextBlock Text="History" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Connections">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE71B;" Margin="0,0,12,0" />
                            <TextBlock Text="Connections" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Margin="0,0,12,0" />
                            <TextBlock Text="Settings" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False" />
    </Grid>
</Window>
